# Ruta a Tesseract si no está en el PATH
TESSERACT_CMD=D:\Tesseract OCR\tesseract.exe
# Si se define, la app debe enviar la cabecera X-API-Key con este valor
# SERVIAPP_API_KEY=
# Tamaño máximo de la foto en MB
MAX_UPLOAD_MB=15

# URL pública de Spring y la misma clave configurada como ML_INTERNAL_API_KEY
# en Spring Boot. FastAPI la envía solo a /api/internal/ml/**.
SPRING_BOOT_URL=http://localhost:8080
ML_INTERNAL_API_KEY=pon_una_clave_larga_igual_en_ambos_servicios
SPRING_TIMEOUT_SECONDS=15
